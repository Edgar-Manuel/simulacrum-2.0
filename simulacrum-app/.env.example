# ============================================
# SIMULACRUM - Environment Variables (TEMPLATE)
# ============================================
# Copy this file to `.env` and fill in your own keys.
# NEVER commit a real `.env` to version control.
#
# Note: Variables prefixed with VITE_ are inlined into the
# frontend bundle at build time. Anything sensitive here will
# be readable by anyone who downloads the built app. For real
# trading secrets (exchange API/secret), use the backend only.
# ============================================

# --- AI SERVICES (frontend - public in bundle) ---
# Groq:        https://console.groq.com/keys
# Gemini:      https://aistudio.google.com/app/apikey
# OpenRouter:  https://openrouter.ai/keys
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENROUTER_API_KEY=

# Optional secondary keys (rotation / load balancing)
VITE_GROQ_API_KEY_2=
VITE_GEMINI_API_KEY_2=
VITE_OPENROUTER_API_KEY_2=

# --- MARKET DATA (optional) ---
VITE_CRYPTOCOMPARE_API_KEY=
VITE_LUNARCRUSH_API_KEY=
VITE_TWITTER_BEARER_TOKEN=

# --- WEB3 ---
VITE_ALCHEMY_API_KEY=
VITE_INFURA_API_KEY=
VITE_WALLETCONNECT_PROJECT_ID=

# --- TRADING SETTINGS ---
# Keep paper trading ON until you have audited risk controls.
VITE_PAPER_TRADING_MODE=true

# Risk Management Defaults (percentages)
VITE_MAX_POSITION_SIZE=5
VITE_MAX_DAILY_LOSS=5
VITE_DEFAULT_STOP_LOSS=2
VITE_DEFAULT_TAKE_PROFIT=4

# Shared auth token. Must match BACKEND_AUTH_TOKEN in backend/.env. The
# frontend sends it as `x-simulacrum-token` on every backend request.
# Without it, trading endpoints reject the call.
VITE_BACKEND_TOKEN=

# Override the backend base URL if not running on the default port
# VITE_BACKEND_URL=http://localhost:3001

# ============================================
# BACKEND-ONLY (server-side, NOT bundled to frontend)
# These belong in `backend/.env`, NOT here. NEVER prefix exchange API keys
# with VITE_ — Vite inlines them into the public bundle.
# ============================================
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BACKEND_AUTH_TOKEN=
# BACKEND_PORT=3001
