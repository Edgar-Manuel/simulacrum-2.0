# ============================================
# SIMULACRUM - BACKEND SERVER CONFIGURATION
# ============================================
# Copy this file to ../.env or set these environment variables

# Binance API Keys
# Get TESTNET keys from: https://testnet.binance.vision/
# Get LIVE keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

# Server Configuration
BACKEND_PORT=3001

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. For TESTING, use Binance Testnet keys first!
#    - Go to https://testnet.binance.vision/
#    - Generate API keys there
#    - These work with sandbox/testnet mode
#
# 2. For LIVE trading:
#    - Go to Binance > Account > API Management
#    - Create new API key
#    - Enable "Spot & Margin Trading"
#    - (Optional) Enable "Futures" if needed
#    - Whitelist your IP for security
#
# 3. Never share or commit your API keys!
