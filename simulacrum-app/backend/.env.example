# ============================================
# SIMULACRUM - BACKEND SERVER CONFIGURATION
# ============================================
# Copy this file to ../.env or set these environment variables

# Binance API Keys
# Get TESTNET keys from: https://testnet.binance.vision/
# Get LIVE keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

# Server Configuration
BACKEND_PORT=3001

# Shared auth token between backend and frontend. The backend rejects any
# trading/portfolio request that does not carry this token in the
# `x-simulacrum-token` header. Generate a long random string (e.g.
# `openssl rand -hex 32`). Pair it with VITE_BACKEND_TOKEN in the frontend.
BACKEND_AUTH_TOKEN=

# Bind address. Default 127.0.0.1 keeps the API local-only (recommended).
# Use 0.0.0.0 only if you understand the risk and have firewall rules.
BACKEND_BIND=127.0.0.1

# Comma-separated list of allowed CORS origins. Defaults to the Vite dev ports.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000

# Set BINANCE_USE_TESTNET=true to route the SDK against Binance testnet
# instead of LIVE. Useful for paper / staging without touching real funds.
BINANCE_USE_TESTNET=false

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. For TESTING, use Binance Testnet keys first!
#    - Go to https://testnet.binance.vision/
#    - Generate API keys there
#    - These work with sandbox/testnet mode
#
# 2. For LIVE trading:
#    - Go to Binance > Account > API Management
#    - Create new API key
#    - Enable "Spot & Margin Trading"
#    - (Optional) Enable "Futures" if needed
#    - Whitelist your IP for security
#
# 3. Never share or commit your API keys!
